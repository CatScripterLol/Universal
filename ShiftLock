local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local pg = player:WaitForChild("PlayerGui")

if pg:FindFirstChild("MobileShiftLock") then
	pg.MobileShiftLock:Destroy()
end

local locked = false
local rotateConn
local diedConn

local OFFSET_ON = Vector3.new(1.75, 0.5, 0)
local OFFSET_OFF = Vector3.new(0, 0, 0)

local function getHum()
	local char = player.Character
	if not char then return nil, nil end
	return char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end

local function stopRotate()
	if rotateConn then
		rotateConn:Disconnect()
		rotateConn = nil
	end
end

local gui = Instance.new("ScreenGui")
gui.Name = "MobileShiftLock"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = pg

local btn = Instance.new("ImageButton")
btn.Name = "ShiftLockBtn"
btn.Size = UDim2.new(0, 52, 0, 52)
btn.Position = UDim2.new(1, -16, 1, -16)
btn.AnchorPoint = Vector2.new(1, 1)
btn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
btn.BackgroundTransparency = 0.2
btn.AutoButtonColor = true
btn.Image = ""
btn.Parent = gui

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(1, 0)
btnCorner.Parent = btn

local btnStroke = Instance.new("UIStroke")
btnStroke.Color = Color3.fromRGB(100, 100, 110)
btnStroke.Thickness = 1.5
btnStroke.Parent = btn

local icon = Instance.new("TextLabel")
icon.Size = UDim2.new(1, 0, 1, 0)
icon.BackgroundTransparency = 1
icon.Text = "🔒"
icon.TextScaled = true
icon.Font = Enum.Font.GothamBold
icon.TextColor3 = Color3.fromRGB(210, 210, 220)
icon.Parent = btn

local iconPad = Instance.new("UIPadding")
iconPad.PaddingTop = UDim.new(0, 10)
iconPad.PaddingBottom = UDim.new(0, 10)
iconPad.PaddingLeft = UDim.new(0, 10)
iconPad.PaddingRight = UDim.new(0, 10)
iconPad.Parent = icon

local crosshair = Instance.new("Frame")
crosshair.Name = "Crosshair"
crosshair.Size = UDim2.new(0, 6, 0, 6)
crosshair.Position = UDim2.new(0.5, 0, 0.5, 0)
crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
crosshair.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
crosshair.BorderSizePixel = 0
crosshair.Visible = false
crosshair.ZIndex = 100
crosshair.Parent = gui

local crossCorner = Instance.new("UICorner")
crossCorner.CornerRadius = UDim.new(1, 0)
crossCorner.Parent = crosshair

local crossStroke = Instance.new("UIStroke")
crossStroke.Color = Color3.fromRGB(0, 0, 0)
crossStroke.Thickness = 1.2
crossStroke.Parent = crosshair

local function applyOffset(hum, on)
	if not hum then return end
	pcall(function()
		hum.CameraOffset = on and OFFSET_ON or OFFSET_OFF
		hum.AutoRotate = not on
	end)
end

local function setLocked(on)
	locked = on
	stopRotate()
	crosshair.Visible = on
	local hum = getHum()
	applyOffset(hum, on)
	if not on then
		pcall(function()
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end)
		return
	end
	pcall(function()
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end)
	rotateConn = RunService.RenderStepped:Connect(function()
		local h, root = getHum()
		if not h or not root or h.Health <= 0 then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.05 then return end
		flat = flat.Unit
		local pos = root.Position
		root.CFrame = CFrame.lookAt(pos, pos + flat)
	end)
end

local function refreshBtn()
	if locked then
		icon.Text = "🔓"
		icon.TextColor3 = Color3.fromRGB(90, 230, 130)
		btnStroke.Color = Color3.fromRGB(60, 180, 100)
		btn.BackgroundColor3 = Color3.fromRGB(22, 42, 32)
	else
		icon.Text = "🔒"
		icon.TextColor3 = Color3.fromRGB(210, 210, 220)
		btnStroke.Color = Color3.fromRGB(100, 100, 110)
		btn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
	end
end

local function bindCharacter(char)
	if diedConn then
		diedConn:Disconnect()
		diedConn = nil
	end
	local hum = char:WaitForChild("Humanoid", 8)
	if not hum then return end
	diedConn = hum.Died:Connect(function()
		stopRotate()
		crosshair.Visible = false
		pcall(function()
			hum.CameraOffset = OFFSET_OFF
			hum.AutoRotate = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end)
	end)
	if locked then
		task.wait(0.2)
		setLocked(true)
		refreshBtn()
	end
end

if player.Character then
	task.spawn(bindCharacter, player.Character)
end
player.CharacterAdded:Connect(bindCharacter)

btn.MouseButton1Click:Connect(function()
	setLocked(not locked)
	refreshBtn()
end)

if UserInputService.KeyboardEnabled then
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			setLocked(not locked)
			refreshBtn()
		end
	end)
end

refreshBtn()
