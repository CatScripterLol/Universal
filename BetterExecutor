executeBtn.MouseButton1Click:Connect(function()
	local code = codeBox.Text
	if not code or code == "" then return end

	local func, loadErr = loadstring(code)
	if not func then
		setStatus("Error: " .. tostring(loadErr), true)
		addLog("Error: " .. tostring(loadErr))
		warn("Script Error: " .. tostring(loadErr))
		return
	end

	local captured = {}
	local oldPrint = print
	local oldWarn = warn

	print = function(...)
		local args = table.pack(...)
		local parts = {}
		for i = 1, args.n do
			table.insert(parts, tostring(args[i]))
		end
		local line = table.concat(parts, "\t")
		table.insert(captured, line)
		oldPrint(...)
	end

	warn = function(...)
		local args = table.pack(...)
		local parts = {}
		for i = 1, args.n do
			table.insert(parts, tostring(args[i]))
		end
		local line = table.concat(parts, "\t")
		table.insert(captured, "[warn] " .. line)
		oldWarn(...)
	end

	local success, result = pcall(func)

	print = oldPrint
	warn = oldWarn

	if success then
		setStatus("Executed successfully", false)
		addLog("Script executed successfully.")
		if #captured > 0 then
			for i = #captured, 1, -1 do
				addLog(captured[i])
			end
		end
		if result ~= nil then
			addLog(tostring(result))
		end
	else
		setStatus("Error: " .. tostring(result), true)
		addLog("Error: " .. tostring(result))
		warn("Script Error: " .. tostring(result))
	end
end)
