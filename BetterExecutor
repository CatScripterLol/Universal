local outputHistory = {}
local maxHistory = 10

local function getTime()
	local t = os.date("*t")
	return string.format("[%02d:%02d:%02d]", t.hour, t.min, t.sec)
end

local function refreshOutput()
	if #outputHistory == 0 then
		outputLabel.Text = "Log will appear here..."
	else
		outputLabel.Text = table.concat(outputHistory, "\n")
	end
end

local function addLog(text)
	local entry = string.format('<font color="#8EC8FF">%s > %s</font>', getTime(), text)
	table.insert(outputHistory, 1, entry)
	if #outputHistory > maxHistory then
		table.remove(outputHistory)
	end
	refreshOutput()
end

local function setStatus(text, isError)
	if isError then
		statusLabel.Text = "  ✕  " .. text
		statusLabel.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
		statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
	else
		statusLabel.Text = "  ✓  " .. text
		statusLabel.BackgroundColor3 = Color3.fromRGB(20, 55, 35)
		statusLabel.TextColor3 = Color3.fromRGB(80, 255, 140)
	end
end

local function makeDraggable(frame, handle)
	local dragging = false
	local dragStart = nil
	local startPos = nil

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)

	handle.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

