-- this cript only works in client side!!
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local removedPlayers = {}
local removedChars = {}
local selectedPlayer = nil

local function getCharacter(player)
	return player and player.Character
end

local function hideCharacter(player)
	local char = getCharacter(player)
	if char and char.Parent then
		removedChars[player] = char
		pcall(function()
			char.Parent = nil
		end)
	end
end

local function showCharacter(player)
	local char = removedChars[player]
	if char then
		pcall(function()
			char.Parent = workspace
		end)
		removedChars[player] = nil
	end
end

local function removePlayer(player)
	if not player or player == LocalPlayer then return end
	removedPlayers[player] = true
	hideCharacter(player)
	pcall(function()
		player.Parent = nil
	end)
end

local function restorePlayer(player)
	if not player then return end
	pcall(function()
		player.Parent = Players
	end)
	showCharacter(player)
	removedPlayers[player] = nil
end

local function removeAll()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			removePlayer(player)
		end
	end
end

local function restoreAll()
	for player in pairs(removedPlayers) do
		restorePlayer(player)
	end
	table.clear(removedPlayers)
	table.clear(removedChars)
end

Players.PlayerAdded:Connect(function(player)
	if player == LocalPlayer then return end
	player.CharacterAdded:Connect(function(char)
		if removedPlayers[player] then
			task.wait()
			hideCharacter(player)
		end
	end)
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		player.CharacterAdded:Connect(function(char)
			if removedPlayers[player] then
				task.wait()
				hideCharacter(player)
			end
		end)
	end
end

