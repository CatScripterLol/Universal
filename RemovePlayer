local function refreshActionButton()
	if currentTab == "Players" then
		actionBtn.Text = "Remove Selected"
		actionBtn.BackgroundColor3 = Color3.fromRGB(160, 50, 50)
	else
		actionBtn.Text = "Restore Selected"
		actionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 70)
	end
end

local oldSetTab = setTab
setTab = function(tab)
	oldSetTab(tab)
	refreshActionButton()
end

actionBtn.MouseButton1Click:Connect(function()
	if not selectedId then return end
	if currentTab == "Players" then
		local player = getPlayerById(selectedId)
		if player then
			removePlayer(player)
			updateList()
		end
	else
		restorePlayer(selectedId)
		updateList()
	end
end)

removeAllBtn.MouseButton1Click:Connect(function()
	removeAll()
	updateList()
end)

restoreAllBtn.MouseButton1Click:Connect(function()
	restoreAll()
	updateList()
end)
