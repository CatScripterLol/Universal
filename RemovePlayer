local listButtons = {}

local function clearList()
	for _, btn in pairs(listButtons) do
		btn:Destroy()
	end
	table.clear(listButtons)
end

local function countHidden()
	local n = 0
	for _ in pairs(hidden) do n = n + 1 end
	return n
end

local function updateList()
	clearList()
	local y = 0

	if currentTab == "Players" then
		for _, player in ipairs(Players:GetPlayers()) do
			if player == LocalPlayer then continue end
			if hidden[player.UserId] then continue end

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -4, 0, 32)
			btn.BackgroundColor3 = (selectedId == player.UserId) and Color3.fromRGB(55, 90, 160) or Color3.fromRGB(30, 30, 36)
			btn.Text = player.DisplayName .. " (@" .. player.Name .. ")"
			btn.TextColor3 = Color3.fromRGB(220, 220, 230)
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 13
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = listFrame

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = btn

			local p = Instance.new("UIPadding")
			p.PaddingLeft = UDim.new(0, 8)
			p.Parent = btn

			local id = player.UserId
			btn.MouseButton1Click:Connect(function()
				selectedId = id
				updateList()
			end)

			listButtons[id] = btn
			y = y + 36
		end
	else
		for id, data in pairs(hidden) do
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -4, 0, 32)
			btn.BackgroundColor3 = (selectedId == id) and Color3.fromRGB(55, 90, 160) or Color3.fromRGB(30, 30, 36)
			btn.Text = data.display .. " (@" .. data.name .. ")"
			btn.TextColor3 = Color3.fromRGB(220, 220, 230)
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 13
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = listFrame

			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = btn

			local p = Instance.new("UIPadding")
			p.PaddingLeft = UDim.new(0, 8)
			p.Parent = btn

			btn.MouseButton1Click:Connect(function()
				selectedId = id
				updateList()
			end)

			listButtons[id] = btn
			y = y + 36
		end
	end

	listFrame.CanvasSize = UDim2.new(0, 0, 0, y + 8)
	hiddenTabBtn.Text = "Hidden (" .. countHidden() .. ")"
end

local function setTab(tab)
	currentTab = tab
	selectedId = nil
	if tab == "Players" then
		playersTabBtn.BackgroundColor3 = Color3.fromRGB(55, 90, 160)
		playersTabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		hiddenTabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		hiddenTabBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
	else
		hiddenTabBtn.BackgroundColor3 = Color3.fromRGB(55, 90, 160)
		hiddenTabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		playersTabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		playersTabBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
	end
	updateList()
end

