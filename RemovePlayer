local listButtons = {}

local function countHidden()
	local n = 0
	for _ in pairs(hidden) do n += 1 end
	return n
end

local actionBtn

local function refreshActionButton()
	if not actionBtn then return end
	if currentTab == "Players" then
		actionBtn.Text = "Remove Selected"
		actionBtn.BackgroundColor3 = Color3.fromRGB(160, 50, 50)
	else
		actionBtn.Text = "Restore Selected"
		actionBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 70)
	end
end

updateList = function()
	for _, b in pairs(listButtons) do
		b:Destroy()
	end
	table.clear(listButtons)

	local y = 0
	if currentTab == "Players" then
		for _, player in ipairs(Players:GetPlayers()) do
			if player == LocalPlayer or hidden[player.UserId] then continue end

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -4, 0, 32)
			btn.BackgroundColor3 = (selectedId == player.UserId) and Color3.fromRGB(55, 90, 160) or Color3.fromRGB(30, 30, 36)
			btn.Text = player.DisplayName .. " (@" .. player.Name .. ")"
			btn.TextColor3 = Color3.fromRGB(220, 220, 230)
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 13
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = listFrame
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
			local pad = Instance.new("UIPadding", btn)
			pad.PaddingLeft = UDim.new(0, 8)

			local id = player.UserId
			btn.MouseButton1Click:Connect(function()
				selectedId = id
				updateList()
			end)
			listButtons[id] = btn
			y += 36
		end
	else
		for id, data in pairs(hidden) do
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -4, 0, 32)
			btn.BackgroundColor3 = (selectedId == id) and Color3.fromRGB(55, 90, 160) or Color3.fromRGB(30, 30, 36)
			btn.Text = data.display .. " (@" .. data.name .. ")"
			btn.TextColor3 = Color3.fromRGB(220, 220, 230)
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 13
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.Parent = listFrame
			Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
			local pad = Instance.new("UIPadding", btn)
			pad.PaddingLeft = UDim.new(0, 8)

			btn.MouseButton1Click:Connect(function()
				selectedId = id
				updateList()
			end)
			listButtons[id] = btn
			y += 36
		end
	end

	listFrame.CanvasSize = UDim2.new(0, 0, 0, y + 8)
	hiddenTabBtn.Text = "Hidden (" .. countHidden() .. ")"
	refreshActionButton()
end

local function setTab(tab)
	currentTab = tab
	selectedId = nil
	if tab == "Players" then
		playersTabBtn.BackgroundColor3 = Color3.fromRGB(55, 90, 160)
		playersTabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		hiddenTabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		hiddenTabBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
	else
		hiddenTabBtn.BackgroundColor3 = Color3.fromRGB(55, 90, 160)
		hiddenTabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		playersTabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		playersTabBtn.TextColor3 = Color3.fromRGB(200, 200, 210)
	end
	updateList()
end

