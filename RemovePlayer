local hold = Instance.new("Folder")
hold.Name = "PR_Hold"
hold.Parent = CoreGui

local function hideChar(char)
	if not char then return end
	pcall(function()
		char.Parent = hold
	end)
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			pcall(function() v.LocalTransparencyModifier = 1 end)
		end
		if v:IsA("Decal") or v:IsA("Texture") then
			pcall(function() v.Transparency = 1 end)
		end
		if v:IsA("BillboardGui") or v:IsA("SurfaceGui") or v:IsA("Highlight") then
			pcall(function() v.Enabled = false end)
		end
		if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
			pcall(function() v.Enabled = false end)
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end)
	end
end

local function showChar(char)
	if not char then return end
	pcall(function()
		char.Parent = workspace
	end)
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			pcall(function() v.LocalTransparencyModifier = 0 end)
		end
		if v:IsA("BillboardGui") or v:IsA("SurfaceGui") or v:IsA("Highlight") then
			pcall(function() v.Enabled = true end)
		end
		if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
			pcall(function() v.Enabled = true end)
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
		end)
	end
end

local function removePlayer(player)
	if not player or player == LocalPlayer then return end
	local id = player.UserId
	if hidden[id] then return end
	hidden[id] = {
		player = player,
		name = player.Name,
		display = player.DisplayName,
	}
	pcall(function()
		player.Parent = nil
	end)
	hideChar(player.Character)
	if selectedId == id then selectedId = nil end
end

local function restorePlayer(id)
	local data = hidden[id]
	if not data then return end

	-- remove from hidden FIRST so heartbeat stops fighting
	hidden[id] = nil
	if selectedId == id then selectedId = nil end

	local player = data.player
	if not player then return end

	pcall(function()
		player.Parent = Players
	end)

	-- wait a frame then show character (engine may recreate/reparent)
	task.defer(function()
		local char = player.Character
		if char then
			showChar(char)
		end
	end)
end

local function removeAll()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			removePlayer(player)
		end
	end
end

local function restoreAll()
	local ids = {}
	for id in pairs(hidden) do
		ids[#ids + 1] = id
	end
	for _, id in ipairs(ids) do
		restorePlayer(id)
	end
end

-- enforce hide only while still in hidden table
RunService.Heartbeat:Connect(function()
	for id, data in pairs(hidden) do
		local player = data.player
		if player then
			if player.Parent ~= nil then
				pcall(function() player.Parent = nil end)
			end
			local char = player.Character
			if char and char.Parent ~= hold then
				hideChar(char)
			end
		end
	end
end)

local function hookCharacter(player)
	if player == LocalPlayer then return end
	player.CharacterAdded:Connect(function(char)
		if hidden[player.UserId] then
			task.defer(function()
				hideChar(char)
			end)
		end
	end)
end

Players.PlayerAdded:Connect(hookCharacter)
for _, p in ipairs(Players:GetPlayers()) do
	hookCharacter(p)
end

