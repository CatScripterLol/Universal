local hidden = {} -- [UserId] = {player = Player, name = string, display = string, char = Model?}
local selectedId = nil
local currentTab = "Players"

local function getPlayerById(id)
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == id then return p end
	end
	for _, data in pairs(hidden) do
		if data.player and data.player.UserId == id then return data.player end
	end
	return nil
end

local function forceHideChar(char)
	if not char then return end
	pcall(function()
		char.Parent = nil
	end)
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
			pcall(function()
				part.LocalTransparencyModifier = 1
				part.Transparency = 1
			end)
		end
		if part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
			pcall(function() part.Enabled = false end)
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end)
	end
end

local function forceShowChar(char)
	if not char then return end
	pcall(function()
		char.Parent = workspace
	end)
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			pcall(function()
				part.LocalTransparencyModifier = 0
			end)
		end
		if part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
			pcall(function() part.Enabled = true end)
		end
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function()
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
			hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
		end)
	end
end

local function removePlayer(player)
	if not player or player == LocalPlayer then return end
	local id = player.UserId
	local char = player.Character
	hidden[id] = {
		player = player,
		name = player.Name,
		display = player.DisplayName,
		char = char
	}
	pcall(function() player.Parent = nil end)
	forceHideChar(char)
	if selectedId == id and currentTab == "Players" then
		selectedId = nil
	end
end

local function restorePlayer(id)
	local data = hidden[id]
	if not data then return end
	local player = data.player
	pcall(function()
		if player then player.Parent = Players end
	end)
	local char = data.char or (player and player.Character)
	forceShowChar(char)
	hidden[id] = nil
	if selectedId == id and currentTab == "Hidden" then
		selectedId = nil
	end
end

local function removeAll()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			removePlayer(player)
		end
	end
end

local function restoreAll()
	local ids = {}
	for id in pairs(hidden) do
		table.insert(ids, id)
	end
	for _, id in ipairs(ids) do
		restorePlayer(id)
	end
end

-- keep forcing hide every frame so engine can't bring them back
RunService.Heartbeat:Connect(function()
	for id, data in pairs(hidden) do
		local player = data.player
		if player then
			if player.Parent ~= nil then
				pcall(function() player.Parent = nil end)
			end
			local char = player.Character or data.char
			if char then
				data.char = char
				if char.Parent ~= nil then
					forceHideChar(char)
				end
			end
		end
	end
end)

Players.PlayerAdded:Connect(function(player)
	if player == LocalPlayer then return end
	player.CharacterAdded:Connect(function(char)
		if hidden[player.UserId] then
			task.defer(function()
				hidden[player.UserId].char = char
				forceHideChar(char)
			end)
		end
	end)
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		player.CharacterAdded:Connect(function(char)
			if hidden[player.UserId] then
				task.defer(function()
					hidden[player.UserId].char = char
					forceHideChar(char)
				end)
			end
		end)
	end
end

